exports[`(b) WorkshopSidebar variant="fr" — operator chrome follows the First Read switch > (e) the default variant is unchanged: CRPV classes, chrome always drawn, no fr-nav-*, no data-variant 1`] = `"<nav class="crpv-ws-tabs crpv-hier-rail" aria-label="Workshop navigation"><button type="button" class="crpv-sidebar-toggle" title="Collapse sidebar" aria-label="Collapse sidebar">‹</button><button type="button" data-all-companies="true" class="crpv-ws-tab crpv-ws-tab-home">All companies</button><div class="crpv-ws-tab-divider"></div><button type="button" data-tab="diagnose" class="crpv-ws-tab">Diagnose</button><button type="button" data-tab="routes" class="crpv-ws-tab">Routes</button><button type="button" data-tab="council" class="crpv-ws-tab">Council</button><button type="button" data-tab="needs" class="crpv-ws-tab">Opportunities</button><button type="button" data-tab="strategy" class="crpv-ws-tab">Strategy</button><button type="button" data-tab="positioning" class="crpv-ws-tab">Positioning</button><button type="button" data-tab="jobmap" class="crpv-ws-tab">Job Map</button><button type="button" data-tab="inputs" class="crpv-ws-tab">Inputs</button><button type="button" data-first-read="true" class="crpv-ws-tab" title="Open the First Read for this company">First read</button><div class="crpv-ws-tab-divider crpv-ws-tab-divider-push"></div><button type="button" class="crpv-ws-tab" style="position: relative;">Inbox</button><button type="button" class="crpv-ws-tab">Company</button><button type="button" class="crpv-ws-tab">Member roles</button><button type="button" class="crpv-ws-tab">Extracts</button><div class="crpv-ws-tab-divider"></div><button type="button" class="crpv-ws-tab" title="Open the full-bleed client story surface" style="color: rgb(156, 110, 21); font-weight: 600;">Client View →</button></nav>"`;
