NEXT_PUBLIC_PRIMARY_CTA_URL=https://example.com/mojomap-intake
NEXT_PUBLIC_SECONDARY_CTA_URL=https://example.com/mojo-diagnostic
NEXT_PUBLIC_LINKEDIN_URL=https://example.com/linkedin
NEXT_PUBLIC_SUBSTACK_URL=https://example.com/substack
NEXT_PUBLIC_YOUTUBE_URL=https://example.com/youtube

# Email delivery for /api/mojomap-intake
# Use a real Resend API key and a verified from-address/domain for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOJOMAP_FROM_EMAIL=FomoMojoDojo Intake <intake@fomomojodojo.com>
MOJOMAP_TO_EMAIL=dojocho@fomomojodojo.com

# Optional: Auto-run MojoMap job after successful intake submission/email.
# If set, /api/mojomap-intake will POST company + website + intake context to this webhook.
# Recommended target:
# https://YOUR_PROJECT_REF.supabase.co/functions/v1/launch-site-intake
MOJOMAP_AUTORUN_WEBHOOK_TOKEN=replace_with_secure_token
MOJOMAP_AUTORUN_WEBHOOK_URL=https://your-mojomap-backend.example.com/api/autorun

# Supabase function secret example values for launch-site-intake:
# INTAKE_AUTORUN_MODE=full
# INTAKE_AUTORUN_USER_EMAIL=admin@example.com
# INTAKE_AUTORUN_USER_PASSWORD=your_password
