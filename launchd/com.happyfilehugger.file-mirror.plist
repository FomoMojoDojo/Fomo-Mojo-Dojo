<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.happyfilehugger.file-mirror</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd /Users/fomomojodojo/dev/happy-file-hugger-main &amp;&amp; npm run files:auto-mirror</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>180</integer>

    <key>StandardOutPath</key>
    <string>/tmp/happy-file-hugger-file-mirror.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/happy-file-hugger-file-mirror.stderr.log</string>
  </dict>
</plist>
